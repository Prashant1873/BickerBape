                    <style>
/* Suppress hover/focus expansion after Escape until next interaction */
#CTAmenu.cta-esc-collapsed a {
    width: 50px !important;      /* match your collapsed width */
    padding: 10px 12px !important;
}
#CTAmenu.cta-esc-collapsed a .cta-label {
    opacity: 0 !important;
    visibility: hidden !important;
}
/* =========================================================
   WCAG 1.4.10 - Reflow Fix
   ========================================================= */

.header,
.header__container,
.header__container > .row,
.header-left {
    max-width: 100%;
    box-sizing: border-box;
}

.header__container {
    width: 100%;
}

.header__container > .row {
    margin-left: 0;
    margin-right: 0;
}

.header-left,
.header-left .header-menu,
.header-menu__content,
.menu,
.js-navList {
    min-width: 0;
}

.menu__nav {
    max-width: 100%;
    box-sizing: border-box;
}

/* =========================================================
   Responsive Header Logo
   ========================================================= */
.responsive-header-logo {
    display: block;
    width: 300px;
    max-width: 100%;
    height: auto;
}

@media (max-width: 767px) {
    .responsive-header-logo {
        width: 220px;
    }
}

@media (max-width: 359px) {
    .responsive-header-logo {
        width: 190px;
    }
}

/* =========================================================
   DESKTOP MEGA MENU - LOCKED LAYOUT (>= 1200px)
   ========================================================= */
@media (min-width: 1200px) {

    /* Mega menu container - fixed width, no shrink */
    .children-items.mega {
        width: 1100px;
        max-width: calc(100vw - 30px);
        box-sizing: border-box;
        overflow: hidden;
    }

    /* The inner wrapper uses flex row */
    .children-items.mega .mega__menu:first-child {
        display: flex;
        flex-wrap: nowrap;
        width: 100%;
    }

    /* Parent row - force flex, not float */
    .children-items.mega .mega__menu > .row {
        display: flex;
        flex-wrap: nowrap;
        width: 100%;
        margin-left: 0;
        margin-right: 0;
    }

    /* Funds by Type column - 75% */
    .children-items.mega .col-9 {
        flex: 0 0 75%;
        max-width: 75%;
        width: 75%;
    }

    /* Funds by Category column - 25% */
    .children-items.mega .col-3 {
        flex: 0 0 25%;
        max-width: 25%;
        width: 25%;
    }

    /* CRITICAL: Force the fund list into a rigid 3-column grid */
    .children-items.mega .products-fund-list {
        display: grid !important;
        grid-template-columns: repeat(3, minmax(0, 1fr)) !important;
        grid-auto-flow: row !important;
        column-gap: 20px;
        row-gap: 12px;
        margin: 0;
        padding: 0;
        list-style: none;
    }

    .children-items.mega .products-fund-list > li {
        min-width: 0;
        width: auto;
    }

    .children-items.mega .products-fund-list a {
        display: flex;
        align-items: center;
        white-space: normal;
        overflow-wrap: anywhere;
        height: auto;
    }

    /* Mega banner (promo cards) - fixed position on the right */
    .children-items.mega .mega-banner {
        display: flex;
        flex-direction: column;
        gap: 10px;
        width: 100%;
    }

    .children-items.mega .mega-banner .col-12 {
        width: 100%;
        max-width: 100%;
    }
     .menu__nav > li.-has-mega-menu > .children-items.mega[aria-hidden="true"] {
        display: none !important;
    }
}
/* =========================================================
   MOBILE / ZOOM (<= 1199px) - Switch to mobile drawer
   ========================================================= */
@media (max-width: 1199px) {

    .header__container {
        width: 100%;
        max-width: 100%;
    }

    .header-left {
        width: 100%;
        min-width: 0;
    }

    .header__logo {
        max-width: calc(100% - 60px);
        min-width: 0;
    }

    .header__logo a {
        display: block;
        max-width: 100%;
    }

    .header__logo img {
        display: block;
        max-width: 100%;
        width: auto;
        height: auto;
    }

    .header-menu__content {
        width: min(100vw, 420px);
        max-width: 100vw;
        box-sizing: border-box;
        overflow-x: hidden;
        overflow-y: auto;
    }

    .header-menu__content a {
        white-space: normal;
        overflow-wrap: anywhere;
        word-break: normal;
    }

    .menu__nav {
        width: 100%;
        max-width: 100%;
        margin-left: 0 !important;
    }

    .menu__nav > li {
        width: 100%;
        max-width: 100%;
    }

    .menu__nav > li > a {
        display: flex;
        align-items: center;
        justify-content: space-between;
        width: 100%;
        min-height: 44px;
        padding: 12px 20px;
        box-sizing: border-box;
    }

    .children-items.subnav {
        width: 100%;
        max-width: 100%;
        box-sizing: border-box;
    }

    .children-items.subnav > li {
        width: 100%;
    }

    .children-items.subnav a {
        display: flex;
        align-items: center;
        width: 100%;
        min-height: 44px;
        padding: 10px 20px;
        box-sizing: border-box;
    }

    .children-items.subnav a,
    .children-items.subnav h2 {
        white-space: normal;
        overflow-wrap: anywhere;
    }

    .menu-icon {
        flex: 0 0 auto;
        max-width: 24px;
    }

    .mobile-hamburger-menu {
        flex: 0 0 auto;
        margin-left: auto !important;
    }

    /* Mobile grid fallback for products-fund-list (inside subnav only) */
    .children-items.subnav .products-fund-list {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 10px 15px;
    }
}

/* =========================================================
   320px / Narrow Viewports
   ========================================================= */
@media (max-width: 767px) {

    .header__container {
        padding-left: 10px;
        padding-right: 10px;
    }

    .header-left {
        width: 100%;
    }

    .header__logo {
        max-width: calc(100vw - 70px);
    }

    .header__logo img {
        max-width: 100%;
        height: auto;
    }

    .header-menu__content {
        width: 100vw;
        max-width: 100vw;
        left: 0;
        right: 0;
    }

    .menu__nav {
        width: 100%;
    }

    .menu__nav > li > a {
        padding-left: 16px;
        padding-right: 16px;
    }

    .children-items.subnav a {
        padding-left: 16px;
        padding-right: 16px;
    }

    .mobile-footer {
        width: 100%;
        box-sizing: border-box;
    }

    .mobile-footer .d-flex {
        flex-wrap: wrap;
        row-gap: 10px;
    }

    .mobile-footer a {
        white-space: normal;
        overflow-wrap: anywhere;
    }

    /* Single column on very small screens */
    .children-items.subnav .products-fund-list {
        grid-template-columns: 1fr;
    }
}

@media (max-width: 359px) {

    .header__container {
        padding-left: 8px;
        padding-right: 8px;
    }

    .header__logo {
        max-width: calc(100vw - 60px);
    }

    .menu__nav > li > a,
    .children-items.subnav a {
        padding-left: 12px;
        padding-right: 12px;
    }

    .mobile-footer {
        padding-left: 12px !important;
        padding-right: 12px !important;
    }
}
</style>


<script>
(function () {
    'use strict';
function closeMegaMenu(trigger, restoreFocus) {
    var parentLi = trigger.closest('li.-has-mega-menu');
    if (!parentLi) return;

    trigger.setAttribute('aria-expanded', 'false');

    var mega = parentLi.querySelector(':scope > .children-items.mega');
    if (mega) mega.setAttribute('aria-hidden', 'true');   // â† key

    if (restoreFocus) trigger.focus();
}

function openMegaMenu(trigger) {
    var parentLi = trigger.closest('li.-has-mega-menu');
    if (!parentLi) return;

    trigger.setAttribute('aria-expanded', 'true');

    var mega = parentLi.querySelector(':scope > .children-items.mega');
    if (mega) mega.setAttribute('aria-hidden', 'false');  // â† key
}
    // Desktop-only. This is the SAME breakpoint your CSS uses (xl:).
    var isDesktop = window.matchMedia('(min-width: 1200px)');

    // Only run when desktop is active. On mobile, do absolutely nothing.
    function initMegaA11y() {
        if (!isDesktop.matches) return;

        var megaTriggers = document.querySelectorAll(
            '.menu__nav > li.-has-mega-menu > a.menu-trigger'
        );

        if (!megaTriggers.length) return;

        // Prevent double-binding if function runs again on resize
        if (megaTriggers[0].dataset.a11yBound === '1') return;
        megaTriggers.forEach(function (t) { t.dataset.a11yBound = '1'; });

        function closeMegaMenu(trigger, restoreFocus) {
            var parentLi = trigger.closest('li.-has-mega-menu');
            if (!parentLi) return;

            trigger.setAttribute('aria-expanded', 'false');

            var mega = parentLi.querySelector(':scope > .children-items.mega');
            if (mega) mega.setAttribute('aria-hidden', 'true');

            if (restoreFocus) trigger.focus();
        }

        // ESC â€” desktop only
        document.addEventListener('keydown', function (e) {
            if (e.key !== 'Escape' && e.key !== 'Esc') return;
            if (!isDesktop.matches) return;

            var openTrigger = null;
            megaTriggers.forEach(function (t) {
                if (t.getAttribute('aria-expanded') === 'true') openTrigger = t;
            });

            if (openTrigger) {
                e.preventDefault();
                e.stopPropagation();
                closeMegaMenu(openTrigger, true);
            }
        }, true);

        // Keep aria-expanded in sync â€” DESKTOP ONLY.
        // All events are guarded by isDesktop.matches so mobile taps never
        // flip the state and never interfere with the mobile drawer.
        megaTriggers.forEach(function (trigger) {
    var parentLi = trigger.closest('li.-has-mega-menu');
    if (!parentLi) return;

    parentLi.addEventListener('mouseenter', function () {
        if (!isDesktop.matches) return;
        openMegaMenu(trigger);
    });

    parentLi.addEventListener('mouseleave', function () {
        if (!isDesktop.matches) return;
        if (document.activeElement !== trigger) {
            closeMegaMenu(trigger, false);
        }
    });

    trigger.addEventListener('focus', function () {
        if (!isDesktop.matches) return;
        openMegaMenu(trigger);
    });

    trigger.addEventListener('blur', function () {
        if (!isDesktop.matches) return;
        setTimeout(function () {
            if (!isDesktop.matches) return;
            if (!parentLi.contains(document.activeElement)) {
                closeMegaMenu(trigger, false);
            }
        }, 100);
    });
});
    }

    // Run on load
    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initMegaA11y);
    } else {
        initMegaA11y();
    }

    // Re-run only when crossing the desktop breakpoint
    if (isDesktop.addEventListener) {
        isDesktop.addEventListener('change', initMegaA11y);
    } else if (isDesktop.addListener) {
        isDesktop.addListener(initMegaA11y); // Safari < 14
    }
})();
</script>
<script>
(function () {
    'use strict';

    var ctaMenu = document.getElementById('CTAmenu');
    if (!ctaMenu) return;

    // WCAG 1.4.13 â€” Escape must dismiss content that appears on
    // hover or focus. We only need to act when the user is
    // interacting with the sidebar (focus inside it or hovering it),
    // and simply blur the active element so the CSS :focus-within
    // state ends and the sidebar collapses back to icon-only.
    document.addEventListener('keydown', function (e) {
        if (e.key !== 'Escape' && e.key !== 'Esc') return;

        var isFocusedInside = ctaMenu.contains(document.activeElement);
        var isHovered = ctaMenu.matches(':hover');

        if (!isFocusedInside && !isHovered) return;

        e.preventDefault();
        e.stopPropagation();

        // Blur anything focused inside so :focus-within no longer matches.
        if (isFocusedInside && document.activeElement) {
            document.activeElement.blur();
        }

        // Briefly suppress hover-based expansion so Escape actually
        // collapses the sidebar even while the mouse is still over it.
        ctaMenu.classList.add('cta-esc-collapsed');

        // Release the suppression on the next user interaction so the
        // sidebar can expand again on hover/focus.
        function release() {
            ctaMenu.classList.remove('cta-esc-collapsed');
            document.removeEventListener('mousemove', release);
            document.removeEventListener('keydown', release);
            document.removeEventListener('click', release);
            document.removeEventListener('focusin', release);
        }
        document.addEventListener('mousemove', release, { once: true });
        document.addEventListener('keydown', release, { once: true });
        document.addEventListener('click', release, { once: true });
        document.addEventListener('focusin', release, { once: true });
    }, true);
})();
</script>

<script>
    const video = document.getElementById("Fakevideo");

    function constrainWiseGuide() {
        const title = document.querySelector(".bot_title");

        if (!title) {
            return;
        }

        const container = title.closest("[class*='bot'], [id*='bot'], [class*='chat'], [id*='chat']") || title.parentElement;

        if (container) {
            container.classList.add("responsive-wise-guide");
        }
    }

    $(function() {
        // $('#FakePopupModel').modal('show');
        //$('#WIW2025PopupModel').modal('show');
        //$('#SVFPopupModel').modal('show');
        //$('#UPIPopupModel').modal('show');
        // videoStart();
        InitTabMenuOwl();
        constrainWiseGuide();

        new MutationObserver(constrainWiseGuide).observe(document.body, {
            childList: true,
            subtree: true
        });

        /*$('#NFOPopupModel').modal('show');*/
    
        
    });
    
    
</script>
